# ── rich-editor local environment ─────────────────────────────
# Copy to .env.local and fill in your API key.

# Optional: override API base URL (default: same-origin /api routes)
# NEXT_PUBLIC_API_URL=http://localhost:3000/api

# OpenAI — required for real AI output (server-side only, never exposed to browser)
OPENAI_API_KEY=sk-your-key-here

# Optional: override default model
# OPENAI_MODEL=gpt-4o-mini

# Optional: faster model dedicated to autocomplete
# OPENAI_AUTOCOMPLETE_MODEL=gpt-4o-mini

# Optional: Anthropic (not wired yet — OpenAI is used when set above)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
